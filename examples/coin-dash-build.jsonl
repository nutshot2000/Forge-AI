{"cmd": "script", "name": "player", "code": "// Arrow keys or WASD move the hero one tile per tick.\nfn tick(me) {\n    let p = get(me);\n    if p.hp <= 0 { return; }\n    let dx = 0;\n    let dy = 0;\n    if key(\"left\") || key(\"a\") { dx = -1; }\n    else if key(\"right\") || key(\"d\") { dx = 1; }\n    else if key(\"up\") || key(\"w\") { dy = -1; }\n    else if key(\"down\") || key(\"s\") { dy = 1; }\n    if dx != 0 || dy != 0 { move_by(me, dx, dy); }\n    let p = get(me);\n    for e in at(p.x, p.y) {\n        if e.kind == \"coin\" {\n            destroy(e.id);\n            set(me, \"gold\", p.gold + 1);\n            emit(\"coin_picked\", #{ x: p.x, y: p.y });\n        }\n    }\n}\n"}
{"cmd": "script", "name": "slime", "code": "// Chase the hero when it's in sight, otherwise wander. Bites on contact, then cools down.\nfn tick(me) {\n    let s = get(me);\n    let heroes = find(\"hero\");\n    if heroes.is_empty() { return; }\n    let h = heroes[0];\n    if s.cooldown > 0 { set(me, \"cooldown\", s.cooldown - 1); }\n    let dist = abs(h.x - s.x) + abs(h.y - s.y);\n    if dist <= 1 && s.cooldown == 0 && h.hp > 0 {\n        set(h.id, \"hp\", h.hp - s.dmg);\n        set(me, \"cooldown\", 4);\n        emit(\"hit\", #{ x: h.x, y: h.y, hp: h.hp - s.dmg });\n        return;\n    }\n    // Slimes are slow: they only move every other tick.\n    if now() % 2 == 0 { return; }\n    if dist <= s.sight {\n        move_toward(me, h.x, h.y);\n    } else {\n        let d = [[1, 0], [-1, 0], [0, 1], [0, -1]][rand(4)];\n        move_by(me, d[0], d[1]);\n    }\n}\n"}
{"cmd": "script", "name": "rules", "code": "// Runs once per tick after every entity: HUD, winning and losing.\nfn rules() {\n    let hs = find(\"hero\");\n    if hs.is_empty() { return; }\n    let h = hs[0];\n    let hearts = \"\";\n    for i in 0..h.hp { hearts += \"♥\"; }\n    hud(\"hp\", \"HP   \" + hearts);\n    hud(\"gold\", \"Gold \" + h.gold + \" / \" + state(\"total\", 0));\n    if h.hp <= 0 && !state(\"over\", false) {\n        set_state(\"over\", true);\n        hud(\"msg\", \"GAME OVER · press Undo to try again\");\n        emit(\"game_over\");\n    }\n    if count(\"coin\") == 0 && !state(\"won\", false) {\n        set_state(\"won\", true);\n        hud(\"msg\", \"YOU WIN! Every coin collected\");\n        emit(\"win\");\n    }\n}\n"}
