# Mouse input, clicking entities, UI elements and buttons, cheap bullets, hit-stop, angles, effects.
{"cmd":"new","width":12,"height":8}
{"cmd":"physics","preset":"topdown"}

# the mouse, hovering and clicking entities
{"cmd":"script","name":"crate","code":"fn on_click(me) { set(me, \"clicks\", prop(me, \"clicks\", 0) + 1); particles(\"dust\", 3.5, 3.5); float_text(3.5, 3, \"+1\", \"#ffd060\"); }"}
{"cmd":"create","kind":"crate","x":3,"y":3,"props":{"script":"crate"},"expect":{"id":1}}
{"cmd":"input","mouse":[3.5,3.5],"mouse_ui":[40,50],"expect":{"mouse":[3.5,3.5]}}
{"cmd":"exec","code":"[mouse_x(), mouse_y(), mouse_ui_x(), hovered(), mouse_down(\"left\")]","expect":{"result":[3.5,3.5,40,1,false]}}
{"cmd":"input","click":[3.5,3.5]}
{"cmd":"step","ticks":1,"expect":{"events":{"counts":{"click":1,"fx":2}}}}
{"cmd":"get","id":1,"expect":{"entity":{"clicks":1}}}
{"cmd":"exec","code":"mouse_down(\"left\")","expect":{"result":false}}
{"cmd":"input","click":[9.5,5.5]}
{"cmd":"step","ticks":1,"expect":{"events":{"counts":{"click":null}}}}
{"cmd":"input","mouse_down":"right"}
{"cmd":"exec","code":"[mouse_down(\"right\"), mouse_pressed(\"right\")]","expect":{"result":[true,true]}}
{"cmd":"step","ticks":1}
{"cmd":"exec","code":"[mouse_down(\"right\"), mouse_pressed(\"right\")]","expect":{"result":[true,false]}}
{"cmd":"input","mouse_up":"right"}

# UI elements and buttons
{"cmd":"script","name":"rules","code":"fn on_ui(name) { if name == \"start\" { set_state(\"started\", true); ui_remove(\"start\"); } }"}
{"cmd":"exec","code":"ui(\"score\", #{ type: \"text\", text: \"Score 0\", x: 2, y: 2 }); ui(\"start\", #{ type: \"button\", text: \"Start\", x: 50, y: 60, anchor: \"center\" }); ui_set(\"score\", \"text\", \"Score 5\"); 0"}
{"cmd":"look","expect":{"ui":{"score":{"type":"text","text":"Score 5"},"start":{"type":"button"}}}}
{"cmd":"exec","code":"ui_set(\"nothing\", \"text\", \"x\")","expect":{"ok":false,"error":{"$contains":"no ui element"}}}
{"cmd":"input","ui_click":"start"}
{"cmd":"step","ticks":1,"expect":{"events":{"counts":{"ui_click":1}}}}
{"cmd":"exec","code":"[state(\"started\"), ui_clicked(\"start\")]","expect":{"result":[true,false]}}
{"cmd":"look","expect":{"ui":{"start":null}}}

# scriptless bullets: lifetime and die_on_wall
{"cmd":"create","kind":"spark","x":6,"y":6,"props":{"lifetime":3},"expect":{"id":2}}
{"cmd":"step","ticks":2}
{"cmd":"exec","code":"exists(2)","expect":{"result":true}}
{"cmd":"step","ticks":1}
{"cmd":"exec","code":"exists(2)","expect":{"result":false}}
{"cmd":"create","kind":"bullet","x":8,"y":2,"props":{"physics":true,"die_on_wall":true,"w":0.3,"h":0.3,"vx":20},"expect":{"id":3}}
{"cmd":"step","ticks":20,"expect":{"events":{"counts":{"crashed":1}}}}
{"cmd":"exec","code":"exists(3)","expect":{"result":false}}

# hit-stop: time passes, nothing moves
{"cmd":"create","kind":"mover","x":2,"y":6,"props":{"physics":true,"vx":6},"expect":{"id":4}}
{"cmd":"step","ticks":1}
{"cmd":"exec","code":"let x0 = get(4).x; freeze(5); x0","expect":{"result":"*"}}
{"cmd":"step","ticks":5}
{"cmd":"exec","code":"get(4).x == x0","expect":{"result":true}}
{"cmd":"step","ticks":1}
{"cmd":"exec","code":"get(4).x > x0","expect":{"result":true}}

# angles
{"cmd":"exec","code":"let v = vel_from_angle(90, 2); [v[0].round(), v[1], turn_toward(350, 10, 30), turn_toward(0, 90, 30), angle_to_point(1, 3.5, 10)]","expect":{"result":[0,2,370,30,90]}}
{"cmd":"exec","code":"set(4, \"angle\", 180); move_forward(4, 3); [get(4).vx, get(4).vy.abs() < 0.001]","expect":{"result":[-3,true]}}

# screen effects
{"cmd":"exec","code":"fade_out(30); 0"}
{"cmd":"look","expect":{"effect":{"kind":"fade_out","color":"#000000","dur":30}}}
{"cmd":"exec","code":"flash(6, \"#ff0000\"); 0"}
{"cmd":"look","expect":{"effect":{"kind":"flash","color":"#ff0000"}}}
