# Timers, tweens, messages, screens, game-wide values and levels.
{"cmd":"new","width":10,"height":6}

# timers: once and repeating, calling on_timer
{"cmd":"script","name":"bomb","code":"fn on_timer(me, name, data) { if name == \"boom\" { emit(\"boom\", data); destroy(me); } if name == \"tick\" { set(me, \"ticks\", prop(me, \"ticks\", 0) + 1); } }"}
{"cmd":"create","kind":"bomb","x":2,"y":2,"props":{"script":"bomb"},"expect":{"id":1}}
{"cmd":"exec","code":"after(1, 10, \"boom\", #{ size: 3 }); every(1, 3, \"tick\"); 0"}
{"cmd":"look","expect":{"timers":{"$len":2}}}
{"cmd":"step","ticks":9,"expect":{"events":{"counts":{"boom":null}}}}
{"cmd":"get","id":1,"expect":{"entity":{"ticks":3}}}
{"cmd":"step","ticks":1,"expect":{"events":{"counts":{"boom":1},"recent":[{"kind":"boom","data":{"size":3}}]}}}
{"cmd":"exec","code":"count(\"bomb\")","expect":{"result":0}}
{"cmd":"step","ticks":5}
{"cmd":"look","expect":{"timers":{"$len":0}}}
{"cmd":"exec","code":"after(-5, 0, \"x\")","expect":{"ok":false,"error":{"$contains":"at least 1"}}}

# world timers go to rules.on_timer(name, data)
{"cmd":"script","name":"rules","code":"fn on_timer(name, data) { set_state(\"fired\", name); }"}
{"cmd":"exec","code":"after(-1, 2, \"wave\"); 0"}
{"cmd":"step","ticks":2}
{"cmd":"exec","code":"state(\"fired\")","expect":{"result":"wave"}}

# tweens ease a value to its target and finish exactly on it
{"cmd":"create","kind":"lift","x":1,"y":1,"props":{"alpha":1},"expect":{"id":2}}
{"cmd":"exec","code":"tween(2, \"x\", 5, 10, \"linear\"); tween(2, \"alpha\", 0, 4); 0"}
{"cmd":"step","ticks":5}
{"cmd":"get","id":2,"expect":{"entity":{"x":3,"alpha":0}}}
{"cmd":"step","ticks":5}
{"cmd":"get","id":2,"expect":{"entity":{"x":5}}}
{"cmd":"look","expect":{"tweens":0}}

# messages: send to one, broadcast to all listeners, delivered the same tick
{"cmd":"script","name":"door","code":"fn on_message(me, msg, data) { if msg == \"open\" { set(me, \"open\", true); set(me, \"by\", data); } if msg == \"alarm\" { set(me, \"alarmed\", true); } }"}
{"cmd":"script","name":"button","code":"fn tick(me) { if pressed(\"e\") { send(prop(me, \"target\", 0), \"open\", \"button\"); } }"}
{"cmd":"create","kind":"door","x":7,"y":2,"props":{"script":"door"},"expect":{"id":3}}
{"cmd":"create","kind":"door","x":8,"y":2,"props":{"script":"door"},"expect":{"id":4}}
{"cmd":"create","kind":"button","x":6,"y":4,"props":{"script":"button","target":3},"expect":{"id":5}}
{"cmd":"input","tap":"e"}
{"cmd":"step","ticks":1}
{"cmd":"get","id":3,"expect":{"entity":{"open":true,"by":"button"}}}
{"cmd":"get","id":4,"expect":{"entity":{"open":null}}}
{"cmd":"exec","code":"broadcast(\"alarm\"); 0"}
{"cmd":"step","ticks":1}
{"cmd":"exec","code":"[get(3).alarmed, get(4).alarmed]","expect":{"result":[true,true]}}
{"cmd":"script","name":"echo","code":"fn on_message(me, msg, data) { send(me, msg); }"}
{"cmd":"create","kind":"echo","x":1,"y":4,"props":{"script":"echo"},"expect":{"id":6}}
{"cmd":"exec","code":"send(6, \"ping\"); 0"}
{"cmd":"step","ticks":1,"expect":{"events":{"counts":{"script_error":1}}}}

# screens
{"cmd":"exec","code":"show_screen(\"GAME OVER\", \"You ran out of lives\", \"Press R\"); screen_shown()","expect":{"result":true}}
{"cmd":"step","ticks":1,"expect":{"screen":{"title":"GAME OVER","text":"You ran out of lives","prompt":"Press R"}}}
{"cmd":"exec","code":"hide_screen(); screen_shown()","expect":{"result":false}}

# levels: goto_level switches world folders, game values carry over
{"cmd":"new","width":6,"height":4}
{"cmd":"exec","code":"set_game(\"score\", 0); 0"}
{"cmd":"save","path":"$TMP/game/two"}
{"cmd":"new","width":8,"height":5}
{"cmd":"script","name":"rules","code":"fn rules() { if now() == 3 { set_game(\"score\", 42); goto_level(\"two\"); } }"}
{"cmd":"save","path":"$TMP/game/one"}
{"cmd":"load","path":"$TMP/game/one","expect":{"size":[8,5]}}
{"cmd":"step","ticks":10,"expect":{"level":{"changed":["one","two"]}}}
{"cmd":"state","expect":{"size":[6,4]}}
{"cmd":"exec","code":"[level(), game(\"score\")]","expect":{"result":["two",42]}}
{"cmd":"events","kinds":["level_start"],"expect":{"counts":{"level_start":1}}}
{"cmd":"goto","level":"one","expect":{"ok":true,"size":[8,5]}}
{"cmd":"goto","level":"nowhere","expect":{"ok":false,"error":{"$contains":"nowhere"}}}
{"cmd":"exec","code":"goto_level(\"nowhere\"); 0"}
{"cmd":"step","ticks":1,"expect":{"events":{"counts":{"script_error":1}}}}
